{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/generate-questions.ts": {
      "maxDuration": 60,
      "includeFiles": "data/curated/**"
    },
    "api/fact-check.ts": {
      "maxDuration": 60
    },
    "api/room.ts": {
      "maxDuration": 60
    },
    "api/curated-bank.ts": {
      "includeFiles": "data/curated/**"
    },
    "api/calib-stats.ts": {
      "includeFiles": "data/curated/**"
    },
    "api/tts.ts": {
      "maxDuration": 25
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}
