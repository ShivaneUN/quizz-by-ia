{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/generate-questions.ts": {
      "maxDuration": 60,
      "includeFiles": "{data/curated/**,public/drapeaux/drapeaux.json}"
    },
    "api/fact-check.ts": {
      "maxDuration": 60
    },
    "api/room.ts": {
      "maxDuration": 60,
      "includeFiles": "public/drapeaux/drapeaux.json"
    },
    "api/morpion.ts": {
      "maxDuration": 10
    },
    "api/pendu-words.ts": {
      "maxDuration": 15
    },
    "api/curated-bank.ts": {
      "includeFiles": "data/curated/**"
    },
    "api/calib-stats.ts": {
      "includeFiles": "data/curated/**"
    },
    "api/tts.ts": {
      "maxDuration": 25
    }
  },
  "rewrites": [
    { "source": "/api/gen-status", "destination": "/api/generate-questions" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "installCommand": "npm install"
}
