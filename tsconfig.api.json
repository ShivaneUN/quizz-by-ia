{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "api/**/*.ts",
    "server/**/*.ts",
    "src/lib/pendu.ts",
    "src/lib/penduWords.ts",
    "src/lib/penduFill.ts",
    "src/lib/flagQuiz.ts",
    "src/lib/shuffle.ts",
    "src/lib/quizScope.ts",
    "src/types/index.ts",
    "src/types/audit.ts"
  ]
}
